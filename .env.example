# CAMS environment ù?copy to .env and fill secrets. Never commit .env.

APP_ENV=local
# CAMS_APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Africa/Harare

DB_HOST=127.0.0.1
DB_NAME=cams_db
DB_USER=root
DB_PASS=

# Outgoing mail (Gmail SMTP + App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=chitaurotanaka00@gmail.com
MAIL_FROM=chitaurotanaka00@gmail.com
MAIL_FROM_NAME=CAMS
MAIL_PASSWORD=

# First/default admin (temporary password ó must change after login)
BOOTSTRAP_ADMIN_EMAIL=chitaurotanaka00@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@CAMS1

# Google OAuth ù?https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/auth/oauth-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth ù?https://github.com/settings/developers
# Authorization callback URL: {APP_URL}/auth/oauth-callback.php
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


